def message_uuids(path):
    """uuids of the real messages: assistant entries and user prompts (local-command noise is ignored).
    None when the file cannot be read: callers must not treat that as 'no messages'."""
    out = set()
    f, mm = open_mm(path)
    if mm is None:
        try:
            return out if os.path.getsize(path) == 0 else None
        except OSError:
            return None
    try:
        pos, L = 0, len(mm)
        while pos < L:
            e = mm.find(b'\n', pos)
            if e < 0:
                e = L
            line = mm[pos:e]
            pos = e + 1
            if b'"uuid":"' not in line:
                continue
            if b'"type":"assistant"' in line:
                d = parse(line)
                if d and d.get('type') == 'assistant' and d.get('uuid'):
                    out.add(d['uuid'])
            elif b'"type":"user"' in line:
                d = parse(line)
                if d and d.get('type') == 'user' and d.get('uuid'):
                    txt = text_of((d.get('message') or {}).get('content'))
                    if is_prompt(d, txt) or b'"tool_result"' in line:
                        out.add(d['uuid'])
    finally:
        mm.close()
        f.close()
    return out


def lineage_live(rec, live):
    return any(m['id'] in live for m in rec['members'])


def cmd_dedupe(args):
    """Trash the copies of a conversation that hold no message of their own.
    A copy is a fork or a daemon worker transcript whose user prompts and assistant messages
    all exist in transcripts that stay on disk. --forks N also trashes forks with at most
    N messages of their own (they are listed first, so you can judge)."""
    yes = '--yes' in args
    max_own = int_arg(args, '--forks', 0)
    sessions = build_index()
    live = live_sessions()
    pins = load_pins()
    lin = lineages(sessions, live)
    safe, kept = [], []      # (member, lineage, own_count, reason)
    seen = set()
    for s in sessions:
        rec = lin[s['id']]
        if id(rec) in seen or len(rec['members']) < 2:
            continue
        seen.add(id(rec))
        uu = {m['id']: message_uuids(m['path']) for m in rec['members']}
        retained = [m for m in rec['members'] if m['id'] == rec['head']]
        candidates = []
        for m in rec['members']:
            if m['id'] == rec['head']:
                continue
            why = ('conversation open now' if lineage_live(rec, live) else
                   'pinned' if m['id'] in pins else
                   'could not be read' if m.get('unreadable') or uu[m['id']] is None else None)
            if why:
                retained.append(m)
                kept.append((m, rec, None, why))
            else:
                candidates.append(m)
        # newest first; what a copy holds must exist in the transcripts that stay, not in other copies
        for m in sorted(candidates, key=lambda m: -m['mtime']):
            staying = set().union(*(uu[r['id']] or set() for r in retained)) if retained else set()
            own = len(uu[m['id']] - staying)
            if own > max_own:
                retained.append(m)
                kept.append((m, rec, own, f'{own} own message(s)'))
            else:
                safe.append((m, rec, own, list(retained)))   # the transcripts this decision relies on
    kept.sort(key=lambda t: (t[2] is None, t[2] or 0))
    if kept:
        print(c('1', f"kept ({len(kept)}):"))
        for m, rec, own, why in kept:
            kind = 'worker' if m['id'] in rec['workers'] else 'fork'
            print(f"  {fmt_full(m['mtime'])}  {m['id'][:8]}  {kind:6}  {squash(title_of(m), 48):48}  {c('33', why)}")
        print(c('2', "  (ccs dedupe --forks N also trashes forks with at most N own messages; x in the list trashes one)"))
        print()
    if not safe:
        print('nothing to dedupe: every other copy has messages of its own')
        if not yes:
            pause()
        return
    size = sum(m['size'] for m, _, _, _ in safe)
    print(c('1', f"{len(safe)} cop{'y' if len(safe) == 1 else 'ies'} with no message of their own · {human(size)}"))
    for m, rec, own, _deps in safe:
        kind = 'worker' if m['id'] in rec['workers'] else 'fork'
        extra = f"  ({own} own)" if own else ''
        print(f"  {fmt_full(m['mtime'])}  {m['id'][:8]}  {kind:6}  → kept {rec['head'][:8]}  {squash(title_of(m), 48)}{extra}")
    print(c('2', f"Trash: {TRASH}   (restore with: ccs restore <id>)"))
    if not yes and not confirm('Move them to the trash?'):
        return
    live = live_sessions()                 # re-checked right before touching anything, on a fresh index
    lin = lineages(build_index(), live)
    moved = skipped = 0
    for m, rec, _, deps in safe:
        now = lin.get(m['id'])
        try:
            cur = os.stat(m['path'])
            unchanged = cur.st_size == m['size'] and cur.st_mtime == m['mtime']
            deps_ok = all(os.stat(d['path']).st_size >= d['size'] for d in deps)   # retained ones still there, not truncated
        except OSError:
            unchanged = deps_ok = False
        if now is None or lineage_live(now, live) or not unchanged or not deps_ok:
            skipped += 1
            continue
        trash_session(m, pins)
        moved += 1
    save_pins(pins)
    print(c('32', f"✓ {moved} moved to the trash") + (c('33', f"  ({skipped} skipped: changed or opened meanwhile)") if skipped else ''))


