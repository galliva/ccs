def cmd_rename(sid, new=None):
    s = find(sid)
    if not s:
        print('ccs: session not found')
        pause()
        return
    sid = s['id']
    print(c('1', 'Rename session'))
    print(f"Current: {s.get('title') or s.get('first_prompt') or '(empty)'}")
    print(f"Project: {s.get('cwd') or ''}")
    live = live_sessions()
    if sid in live or lineage_live(lineages(build_index(), live)[sid], live):
        print(c('33', '⚠ This conversation is open in another terminal: rename it there with /rename,'))
        print(c('33', '  otherwise that process would write the old name back on its next save.'))
        pause()
        return
    if new is None:
        prefill = s.get('title') or ''
        try:
            try:
                import readline
                readline.set_startup_hook(lambda: readline.insert_text(prefill))
            except Exception:
                readline = None
            try:
                new = input('New name (empty = cancel): ')
            finally:
                if readline:
                    readline.set_startup_hook()
        except (EOFError, KeyboardInterrupt):
            print()
            return
    new = ' '.join(new.split())
    if not new:
        return
    path = s['path']
    st = os.stat(path)
    # same compact format Claude Code writes (its tail scanner uses a regex without spaces)
    entry = json.dumps({'type': 'custom-title', 'customTitle': new, 'sessionId': sid},
                       ensure_ascii=False, separators=(',', ':'))
    payload = entry.encode('utf-8') + b'\n'
    if st.st_size > 0:
        with open(path, 'rb') as f:
            f.seek(-1, os.SEEK_END)
            if f.read(1) != b'\n':
                payload = b'\n' + payload
    fd = os.open(path, os.O_WRONLY | os.O_APPEND)   # one append, safe against a concurrent writer
    with os.fdopen(fd, 'ab') as f:                     # fdopen writes the whole payload (no short write)
        f.write(payload)
    quiet_file = os.stat(path).st_size == st.st_size + len(payload)
    if quiet_file:
        os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns))  # keep the date ordering unchanged
    side = os.path.join(os.path.dirname(path), sid)
    os.makedirs(side, exist_ok=True)
    write_json_atomic(os.path.join(side, 'custom-title.json'), {'customTitle': new})
    cache = read_json(CACHE, {})
    if isinstance(cache, dict) and path in cache:
        if quiet_file and cache[path].get('size') == st.st_size and cache[path].get('mtime') == st.st_mtime:
            st2 = os.stat(path)
            cache[path].update(title=squash(new, 150), title_src='custom', mtime=st2.st_mtime, size=st2.st_size)
        else:
            del cache[path]               # the entry was stale or someone else appended too: rescan it next time
        write_json_atomic(CACHE, cache)
    print(c('32', f"✓ renamed: {squash(new, 150)}"))


