def cmd_text(args):
    st = load_state()
    if '--ask' in args:
        try:
            cur = st.get('text', '')
            print(c('2', 'Full-text filter: sessions whose prompts contain all the words (empty = clear).'))
            new = input(f"Words [{cur}]: " if cur else 'Words: ').strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        st['text'] = new
    else:
        st['text'] = ' '.join(args).strip()
    save_state(st)


def cmd_grep(args):
    words = ' '.join(args).casefold().split()
    if not words:
        sys.exit('ccs: usage: ccs grep <words>')
    sessions = build_index()
    hits = sorted((s for s in sessions if matches_text(s, words)), key=lambda s: -s['mtime'])
    for s in hits:
        print(f"{s['id']}  {fmt_full(s['mtime'])}  {fit(project_label(s), 18)}  "
              f"{squash(s.get('title') or s.get('first_prompt') or '(empty)', 60)}")
        hit = text_hit(s, words)
        if hit:
            print(c('2', '    ▸ ' + squash(hit, 160)))
    print(c('2', f"{len(hits)} session(s) match"), file=sys.stderr)


def trash_items():
    items = []
    if not os.path.isdir(TRASH):
        return items
    for proj in os.scandir(TRASH):
        if not proj.is_dir():
            continue
        for f in os.scandir(proj.path):
            m = NAME_RE.match(f.name)
            if m and f.is_file():
                items.append(dict(id=m.group(1), path=f.path, proj=proj.name, mtime=f.stat().st_mtime,
                                  deleted=os.stat(f.path).st_ctime))
    items.sort(key=lambda i: -i['deleted'])
    return items


def trash_aside_count():
    try:
        return sum(1 for d in os.scandir(TRASH) if d.is_dir()
                   for f in os.listdir(d.path) if re.search(r'\.jsonl\.\d{8}-\d{6}(-\d+)?$', f))
    except FileNotFoundError:
        return 0


def cmd_trash():
    items = trash_items()
    if not items:
        aside = trash_aside_count()
        print('trash is empty' + (f" (apart from {aside} set-aside backup(s) *.jsonl.<date> in {TRASH}, restore those by hand)" if aside else ''))
        return
    for i in items:
        info = scan_file(i['path'], i['id'])
        print(f"{i['id']}  {fmt_full(i['mtime'])}  {i['proj'].lstrip('-')[-24:]:24}  "
              f"{info.get('title') or info.get('first_prompt') or '(empty)'}")
    print()
    aside = trash_aside_count()
    extra = f" · {aside} older deletion(s) of the same ids kept aside as *.jsonl.<date> (restore those by hand)" if aside else ''
    print(c('2', f"{len(items)} session(s) · restore with: ccs restore <id> · delete for good with: rm -rf {TRASH}{extra}"))


def cmd_restore(sid):
    hits = [i for i in trash_items() if i['id'] == sid or i['id'].startswith(sid)]
    if len(hits) != 1:
        sys.exit('ccs: session not found in the trash (or ambiguous prefix)')
    i = hits[0]
    proj_dir = os.path.join(PROJECTS, i['proj'])
    dest = os.path.join(proj_dir, os.path.basename(i['path']))
    side = os.path.join(TRASH, i['proj'], i['id'])
    dest_side = os.path.join(proj_dir, i['id'])
    if os.path.exists(dest) or (os.path.isdir(side) and os.path.exists(dest_side)):
        sys.exit(f"ccs: {i['id']} already exists in {proj_dir} — refusing to overwrite it")
    os.makedirs(proj_dir, exist_ok=True)
    shutil.move(i['path'], dest)
    if os.path.isdir(side):
        try:
            shutil.move(side, dest_side)
        except OSError as e:
            shutil.move(dest, i['path'])
            sys.exit(f"ccs: restore failed on the sidecar directory ({e}); nothing was changed")
    print(c('32', f"✓ restored {i['id']} into {proj_dir}"))


def cmd_export(sid, out=None, quiet=False, force=False):
    s = find(sid)
    if not s:
        print('ccs: session not found')
        pause()
        return
    title = s.get('title') or s.get('first_prompt') or s['id']
    if not out:
        slug = re.sub(r'[^A-Za-z0-9]+', '-', title).strip('-')[:60] or 'session'
        out = os.path.join(os.path.expanduser('~/Downloads'), f"claude-{slug}-{s['id'][:8]}.md")
    out = os.path.abspath(os.path.expanduser(out))
    if out.endswith('.jsonl') or os.path.realpath(out).startswith(os.path.realpath(CLAUDE_DIR) + os.sep):
        sys.exit("ccs: refusing to write the export inside Claude's own directory or over a transcript")
    if os.path.exists(out) and not force:
        sys.exit(f"ccs: {out} exists (add --force to overwrite)")
    f, mm = open_mm(s['path'])
    lines = [f"# {title}", '', f"- Session: `{s['id']}`", f"- Project: `{s.get('cwd') or ''}`",
             f"- Branch: {s.get('branch') or '-'}", f"- Last activity: {fmt_full(s['mtime'])}",
             f"- Exported: {dt.datetime.now():%d %b %Y %H:%M} with ccs", '', '---', '']
    turns = 0
    if mm:
        try:
            for line in head_lines(mm, 1 << 40):
                if b'"type":"user"' not in line and b'"type":"assistant"' not in line:
                    continue
                d = parse(line)
                if not d or d.get('isSidechain'):
                    continue
                t = d.get('type')
                msg = d.get('message') or {}
                content = msg.get('content')
                if t == 'user':
                    txt = text_of(content)
                    if not is_prompt(d, txt):
                        continue
                    lines += ['## You', '', txt.strip(), '']
                    turns += 1
                elif t == 'assistant':
                    parts = []
                    if isinstance(content, list):
                        for b in content:
                            if not isinstance(b, dict):
                                continue
                            if b.get('type') == 'text' and (b.get('text') or '').strip():
                                parts.append(b['text'].strip())
                            elif b.get('type') == 'tool_use':
                                parts.append(f"> 🔧 `{b.get('name', 'tool')}`")
                    elif isinstance(content, str) and content.strip():
                        parts.append(content.strip())
                    if parts:
                        lines += ['## Claude', '', '\n\n'.join(parts), '']
        finally:
            mm.close()
            f.close()
    if os.path.dirname(out):
        os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, 'w', encoding='utf-8') as fo:
        fo.write('\n'.join(lines))
    print(c('32', f"✓ exported {turns} prompt(s) to {out}"))
    if not quiet:
        pause()


def cmd_open(sid):
    s = find(sid)
    cwd = s.get('cwd') if s else None
    if cwd and os.path.isdir(cwd):
        for opener in ('open', 'xdg-open'):
            try:
                if subprocess.run([opener, cwd], check=False).returncode == 0:
                    return
            except FileNotFoundError:
                continue
        print(cwd)


def cmd_copy(sid):
    s = find(sid)
    if not s:
        return
    import shlex
    cwd = s.get('cwd') or ''
    text = f"cd {shlex.quote(cwd)} && claude --resume {s['id']}" if cwd else f"claude --resume {s['id']}"
    for clip in (['pbcopy'], ['wl-copy'], ['xclip', '-selection', 'clipboard']):
        try:
            if subprocess.run(clip, input=text.encode(), check=False).returncode == 0:
                return
        except FileNotFoundError:
            continue
    print(text)


def cmd_cycle(what):
    st = load_state()
    if what == 'sort':
        st['sort'] = SORTS[(SORTS.index(st['sort']) + 1) % len(SORTS)]
    elif what == 'filter':
        st['filter'] = FILTERS[(FILTERS.index(st['filter']) + 1) % len(FILTERS)]
    elif what == 'all':
        st['show_all'] = not st['show_all']
    elif what == 'forks':
        st['show_forks'] = not st['show_forks']
    save_state(st)


def cmd_reset(show_all):
    st = load_state()
    st['filter'] = 'all'
    st['text'] = ''
    st['show_forks'] = False
    st['show_all'] = bool(show_all)
    save_state(st)


def main(argv):
    cmd = argv[0] if argv else 'list'
    args = argv[1:]
    ensure_private()
    migrate_trash()
    if cmd == 'list':
        cmd_list()
    elif cmd == 'header':
        cmd_header()
    elif cmd == 'keys':
        cmd_keys()
    elif cmd == 'stats':
        cmd_stats()
    elif cmd == 'preview':
        cmd_preview(args[0])
    elif cmd == 'rename':
        cmd_rename(args[0], ' '.join(args[1:]) if len(args) > 1 else None)
    elif cmd == 'pin':
        cmd_pin(args)
    elif cmd == 'delete':
        cmd_delete(args)
    elif cmd == 'trash':
        cmd_trash()
    elif cmd == 'restore':
        cmd_restore(args[0])
    elif cmd == 'export':
        files = [a for a in args[1:] if not a.startswith('--')]
        cmd_export(args[0], files[0] if files else None, quiet='--quiet' in args, force='--force' in args)
    elif cmd == 'open':
        cmd_open(args[0])
    elif cmd == 'copy':
        cmd_copy(args[0])
    elif cmd == 'cycle':
        cmd_cycle(args[0])
    elif cmd == 'text':
        cmd_text(args)
    elif cmd == 'grep':
        cmd_grep(args)
    elif cmd == 'prune':
        cmd_prune(args)
    elif cmd == 'dedupe':
        cmd_dedupe(args)
    elif cmd == 'json-get':          # reads JSON on stdin, prints the value at a dotted path (used for herdr)
        d = json.load(sys.stdin)
        for k in args[0].split('.'):
            d = d.get(k) if isinstance(d, dict) else None
        print(d if d is not None else '')
    elif cmd == 'reset':
        cmd_reset('--all' in args)
    elif cmd == 'reindex':
        try:
            os.remove(CACHE)
        except FileNotFoundError:
            pass
        print(f"index rebuilt: {len(build_index())} sessions")
    elif cmd == 'resolve':          # prints "id<TAB>cwd<TAB>title" for an id or a unique prefix
        s = find(args[0])
        if not s:
            sys.exit(1)
        print(f"{s['id']}\t{s.get('cwd') or ''}\t{squash(s.get('title') or s.get('first_prompt') or '', 60)}")
    elif cmd == 'is-live':          # exit 0 and print the kind (interactive|bg) when the session has a live process
        rec = live_sessions().get(args[0])
        if not rec:
            sys.exit(1)
        print(rec.get('kind') or '')
    else:
        sys.exit(f"ccs: unknown python command {cmd}")


