PY

py() { python3 -I -c "$PYCODE" "$@"; }

usage() { awk 'NR > 1 && /^set -euo pipefail/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$SELF"; }

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "ccs: '$1' is required ($2)" >&2; exit 1; }
}

need_fzf() {
  need fzf "brew install fzf"
  local v
  v=$(fzf --version 2>/dev/null | sed 's/[^0-9.].*//')
  if [[ $(printf '%s\n%s\n' 0.58 "$v" | sort -t. -k1,1n -k2,2n | head -1) != 0.58 ]]; then
    echo "ccs: fzf $v is too old, 0.58 or newer is needed (brew upgrade fzf)" >&2
    exit 1
  fi
}

# Split one "id<TAB>cwd<TAB>rest" line into $id $cwd $rest. `read` with IFS=tab would
# collapse an empty cwd field, so the fields are cut by hand.
split_line() {
  local line="$1" tail
  id="${line%%$'\t'*}"
  tail="${line#*$'\t'}"
  [[ $line == *$'\t'* ]] || tail=""
  cwd="${tail%%$'\t'*}"
  rest="${tail#*$'\t'}"
  [[ $tail == *$'\t'* ]] || rest=""
}

resume_session() {
  local id="$1" cwd="$2" fork="${3:-}"
  local bin="${CCS_CLAUDE_BIN:-claude}"
  command -v "$bin" >/dev/null 2>&1 || bin="$HOME/.local/bin/claude"
  local kind=""
  if [[ -z $fork ]] && kind=$(py is-live "$id"); then
    if [[ $kind == bg ]]; then
      # A daemon worker is running this conversation: attach to it. `--resume` would start a copy.
      echo "→ $bin attach ${id:0:8}  (running in the background: attaching, no copy made)"
      exec "$bin" attach "${id:0:8}"
    fi
    local a
    read -r -p "⚠  This session is open in another Claude Code process; resuming here starts a COPY of it. Continue? [y/N] " a
    [[ $a == [yY] ]] || exit 0
  fi
  if [[ -n $cwd && -d $cwd ]]; then
    cd "$cwd"
  else
    echo "ccs: the project directory no longer exists (${cwd:-?}), starting from \$HOME" >&2
    cd "$HOME"
  fi
  local extra=() env_args=()
  [[ -n $fork ]] && extra=(--fork-session)
  if [[ -n ${CCS_CLAUDE_ARGS:-} ]]; then
    set -f; read -r -d '' -a env_args <<<"$CCS_CLAUDE_ARGS" || true; set +f   # whitespace-separated flags (no quoting), no globbing
  fi
  echo "→ $bin --resume $id ${extra[*]:-}  (in $PWD)"
  exec "$bin" --resume "$id" ${extra[@]+"${extra[@]}"} ${env_args[@]+"${env_args[@]}"} ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
}

# Single-quote a string for a POSIX/zsh/bash command line.
shq() { local q=${1//\'/\'\\\'\'}; printf "'%s'" "$q"; }

# Open the session in a new herdr pane (split to the right of this one) or tab; ccs stays open.
herdr_open() {
  local id="$1" cwd="$2" title="$3" how="${4:-split}" out pane ws=()
  if [[ -z ${HERDR_ENV:-} ]] || ! command -v herdr >/dev/null 2>&1; then
    echo "ccs: not running inside herdr — use Enter to resume here" >&2
    sleep 1.5
    return 1
  fi
  [[ -n $cwd && -d $cwd ]] || cwd="$HOME"
  local label="${title:-$id}"
  label="${label:0:40}"
  if [[ $how == tab ]]; then
    [[ -n ${HERDR_WORKSPACE_ID:-} ]] && ws=(--workspace "$HERDR_WORKSPACE_ID")
    out=$(herdr tab create ${ws[@]+"${ws[@]}"} --cwd "$cwd" --label "$label" --focus) || return 1
    pane=$(printf '%s' "$out" | py json-get result.root_pane.pane_id)
  else
    out=$(herdr pane split ${HERDR_PANE_ID:+--pane "$HERDR_PANE_ID"} --direction right --cwd "$cwd" --focus) || return 1
    pane=$(printf '%s' "$out" | py json-get result.pane.pane_id)
  fi
  if [[ -z $pane ]]; then
    echo "ccs: herdr did not return a pane id: $out" >&2
    sleep 2
    return 1
  fi
  # `pane run` submits command text to the pane's shell: quote everything and go through
  # `ccs resume`, so the pane gets the same attach / copy-warning / argument handling.
  local cmd a
  cmd="$(shq "$SELF") resume $(shq "$id")"
  if ((${#CLAUDE_ARGS[@]})); then
    cmd="$cmd --"
    for a in "${CLAUDE_ARGS[@]}"; do cmd="$cmd $(shq "$a")"; done
  fi
  herdr pane run "$pane" "$cmd" >/dev/null
}

ui() {
  local query="$1"
  need_fzf
  CCS_UI_ARGS=""                             # lets the h / t keys pass `ccs -- …` on to the new pane
  if ((${#CLAUDE_ARGS[@]})); then CCS_UI_ARGS=$(printf '%s\037' "${CLAUDE_ARGS[@]}"); fi   # unit separator between args
  export CCS_UI_ARGS
  py reset ${SHOW_ALL:+--all}
  [[ -n $GREP_TEXT ]] && py text "$GREP_TEXT"
  # keys that only exist in navigation mode (search mode needs them for typing)
  local nav='j,k,g,G,r,p,q,f,x,e,y,o,h,t,s,space,/,?'
  local R="reload(\"\$CCS_SELF\" list)+transform-header(\"\$CCS_SELF\" header)"
  local start=()
  [[ -n $query ]] && start=(--bind "start:unbind($nav)+change-prompt(/ )")
  local sel
  export CCS_FORK_FLAG="$CACHE_DIR/fork-flag.$$"     # one flag per running ccs
  rm -f "$CCS_FORK_FLAG"
  local hdr rows rc
  hdr=$(py header)   # builds/refreshes the index once, before the list starts
  rows=$(py list)    # a python failure stops here with its message instead of an empty list
  set +e
  sel=$(printf '%s\n' "$rows" | SHELL=/bin/sh FZF_DEFAULT_OPTS= fzf --ansi --delimiter $'\t' --with-nth 3.. --no-sort --multi \
      --height=100% --layout=reverse --info=inline-right --border=rounded --header-border=bottom \
      --prompt '> ' --query "$query" --pointer '▶' --marker '✓' \
      --header "$hdr" \
      --preview "\"\$CCS_SELF\" preview {1}" --preview-window 'right,50%,wrap,border-left,<110(down,50%)' \
      --bind 'j:down,k:up,g:first,G:last,q:abort,tab:toggle-preview,space:toggle+down' \
      --bind "f:execute-silent(touch \"\$CCS_FORK_FLAG\")+accept" \
      --bind "r:execute(\"\$CCS_SELF\" rename {1})+$R" \
      --bind "p:execute-silent(\"\$CCS_SELF\" pin {+1})+$R" \
      --bind "x:execute(\"\$CCS_SELF\" delete {+1})+$R" \
      --bind "e:execute(\"\$CCS_SELF\" export {1})" \
      --bind "y:execute-silent(\"\$CCS_SELF\" copy {1})" \
      --bind "o:execute-silent(\"\$CCS_SELF\" open {1})" \
      --bind "h:execute(\"\$CCS_SELF\" herdr {1})" \
      --bind "t:execute(\"\$CCS_SELF\" herdr {1} --tab)" \
      --bind "ctrl-f:execute(\"\$CCS_SELF\" text --ask)+$R" \
      --bind "ctrl-x:execute(\"\$CCS_SELF\" prune)+$R" \
      --bind "s:execute-silent(\"\$CCS_SELF\" cycle sort)+$R" \
      --bind "ctrl-p:execute-silent(\"\$CCS_SELF\" cycle filter)+$R" \
      --bind "ctrl-a:execute-silent(\"\$CCS_SELF\" cycle all)+$R" \
      --bind "ctrl-v:execute-silent(\"\$CCS_SELF\" cycle forks)+$R" \
      --bind "ctrl-r:execute-silent(\"\$CCS_SELF\" reindex)+$R" \
      --bind "?:preview(\"\$CCS_SELF\" keys)" \
      --bind "/:unbind($nav)+change-prompt(/ )" \
      --bind "esc:transform:case \"\$FZF_PROMPT\" in '/ ') echo 'rebind($nav)+change-prompt(> )';; *) echo abort;; esac" \
      ${start[@]+"${start[@]}"})
  rc=$?
  set -e
  case $rc in
    0) ;;
    1|130) exit 0 ;;                      # nothing chosen / quit
    *) echo "ccs: fzf failed (exit $rc)" >&2; exit "$rc" ;;
  esac
  local id cwd rest
  split_line "$(printf '%s\n' "$sel" | head -n1)"
  [[ -n $id ]] || exit 0
  if [[ -e $CCS_FORK_FLAG ]]; then
    rm -f "$CCS_FORK_FLAG"
    resume_session "$id" "$cwd" fork
  fi
  rm -f "$CCS_FORK_FLAG"
  resume_session "$id" "$cwd"
}

case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac
need python3 "brew install python"

CLAUDE_ARGS=()
QUERY=""
SHOW_ALL=""
GREP_TEXT=""
while (($#)); do
  case "$1" in
    --) shift; CLAUDE_ARGS=("$@"); break ;;
    -a|--all) SHOW_ALL=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    list|header|keys|stats|preview|rename|pin|delete|trash|restore|export|open|copy|cycle|reset|reindex|is-live|resolve|grep|prune|dedupe|text|json-get)
      py "$@"; exit $? ;;
    -g|--grep)
      [[ -n ${2:-} ]] || { echo "ccs: usage: ccs -g <words>" >&2; exit 1; }
      GREP_TEXT="$2"; shift 2 ;;
    herdr)
      [[ -n ${2:-} ]] || { echo "ccs: usage: ccs herdr <id> [--tab]" >&2; exit 1; }
      line=$(py resolve "$2") || { echo "ccs: session '$2' not found (or ambiguous prefix)" >&2; exit 1; }
      split_line "$line"
      shift 2; how=split
      while (($#)); do
        case "$1" in
          --tab) how=tab; shift ;;
          --) shift; CLAUDE_ARGS=("$@"); break ;;
          *) echo "ccs: unknown option for herdr: $1" >&2; exit 1 ;;
        esac
      done
      if ((${#CLAUDE_ARGS[@]} == 0)) && [[ -n ${CCS_UI_ARGS:-} ]]; then
        IFS=$'\037' read -r -d '' -a CLAUDE_ARGS < <(printf '%s' "$CCS_UI_ARGS") || true   # no here-string: it would add a newline
      fi
      herdr_open "$id" "$cwd" "$rest" "$how"; exit $? ;;
    resume|fork)
      mode="$1"
      [[ -n ${2:-} ]] || { echo "ccs: usage: ccs $mode <id> [-- arg…]" >&2; exit 1; }
      line=$(py resolve "$2") || { echo "ccs: session '$2' not found (or ambiguous prefix)" >&2; exit 1; }
      shift 2
      [[ ${1:-} == -- ]] && { shift; CLAUDE_ARGS=("$@"); }
      split_line "$line"
      [[ $mode == fork ]] && resume_session "$id" "$cwd" fork
      resume_session "$id" "$cwd" ;;
    -*) echo "ccs: unknown option $1" >&2; usage >&2; exit 1 ;;
    *) QUERY="${QUERY:+$QUERY }$1"; shift ;;
  esac
done

