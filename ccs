def trash_session(s, pins):
    """Move one transcript (+ its sidecar directory) into the trash, keeping the project layout."""
    proj = os.path.basename(s['project_dir'])
    dest_dir = os.path.join(TRASH, proj)
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, os.path.basename(s['path']))
    dest_side = os.path.join(dest_dir, s['id'])
    if os.path.lexists(dest) or os.path.lexists(dest_side):
        # an earlier deletion of the same id: set it aside under a unique suffix, never overwrite
        stamp, n = time.strftime('%Y%m%d-%H%M%S'), 0
        while os.path.lexists(f"{dest}.{stamp}") or os.path.lexists(f"{dest_side}.{stamp}"):
            n += 1
            stamp = f"{time.strftime('%Y%m%d-%H%M%S')}-{n}"
        if os.path.lexists(dest_side):
            os.rename(dest_side, f"{dest_side}.{stamp}")
        if os.path.lexists(dest):
            os.rename(dest, f"{dest}.{stamp}")
    shutil.move(s['path'], dest)
    side = os.path.join(s['project_dir'], s['id'])
    if os.path.isdir(side):
        shutil.move(side, dest_side)
    if s['id'] in pins:
        pins.remove(s['id'])


def int_arg(args, flag, default):
    if flag not in args:
        return default
    i = args.index(flag)
    v = args[i + 1] if i + 1 < len(args) else ''
    if not v.isdigit():
        sys.exit(f"ccs: {flag} needs a whole number (got {v!r})")
    return int(v)


