#!/usr/bin/env bash
# ccs — Claude Code Sessions
#
# A Claude-Desktop-like manager for every Claude Code session (all projects), from outside claude.
#
# Keys (navigation mode):
#   Enter      resume the selected session (claude --resume, run from its project directory;
#              a conversation running in the background is attached with `claude attach`, no copy)
#   f          resume as a fork (new session id, the original stays untouched)
#   r          rename (stored like /rename does, so claude's own --resume picker shows it too)
#   p          pin / unpin (pinned sessions stay on top, alphabetically)
#   x          move to the trash (restorable with `ccs restore <id>`)
#   e          export the conversation to Markdown (~/Downloads)
#   y          copy `cd <cwd> && claude --resume <id>` to the clipboard
#   o          open the project directory in Finder
#   h / t      (inside herdr) resume in a new pane split to the right / in a new tab
#   Space      select several sessions (pin / trash act on all of them)
#   /          search (Esc goes back to navigation, the filter stays)
#   s          cycle sort: date → name → project
#   ctrl-p     cycle filter: all → pinned → open now → this directory
#   ctrl-a     show / hide empty sessions
#   ctrl-v     show / hide forks and daemon copies of the same conversation (folded by default, ⑂N)
#   ctrl-f     full-text filter: keep only sessions whose prompts contain the words
#   ctrl-x     prune: trash old sessions with (almost) no prompts, after confirmation
#   j / k      down / up, g / G first / last, Tab show/hide the preview, ? help
#   ctrl-r     rebuild the index, q quit
#
# Usage:
#   ccs                       open the list
#   ccs <text>                open the list already filtered
#   ccs -a                    start with empty sessions visible
#   ccs -g <words>            start with the full-text filter set (ccs grep <words> prints the matches)
#   ccs -- <arg…>             extra arguments for claude on resume (e.g. ccs -- --model fable)
#   ccs resume|fork <id> [-- arg…]   resume directly (a unique prefix of the id is enough)
#   ccs rename <id> [new name]
#   ccs pin <id> | export <id> [file] | delete <id>… | trash | restore <id>
#   ccs herdr <id> [--tab]    resume in a new herdr pane (or tab)
#   ccs prune [--days N] [--max N] [--yes]   trash sessions older than N days with ≤ N prompts
#   ccs dedupe [--forks N] [--yes]   trash copies of a conversation that hold no message of their own
#   ccs list | grep <words> | preview <id> | stats | reindex | help
#
# Environment:
#   CCS_CLAUDE_ARGS   arguments always appended to claude on resume (space-separated, no quoting)
#   CCS_CLAUDE_DIR    Claude Code directory (default ~/.claude)
#   CCS_CLAUDE_BIN    claude binary (default: the one in PATH)
#
# Own data: ~/.config/ccs/pins, ~/.config/ccs/state.json (sort, filters),
#           ~/.cache/ccs/index.json (index cache), ~/.local/share/ccs/trash/ (deleted sessions).
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
export CCS_SELF="$SELF"       # the fzf command strings reference this variable, never the path itself
export CCS_CLAUDE_DIR="${CCS_CLAUDE_DIR:-$HOME/.claude}"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ccs"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ccs"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/ccs"
export CCS_PINS="${CCS_PINS:-$CONF_DIR/pins}"
export CCS_STATE="${CCS_STATE:-$CONF_DIR/state.json}"
export CCS_CACHE="${CCS_CACHE:-$CACHE_DIR/index.json}"
if [[ -z ${CCS_TRASH:-} ]]; then
  export CCS_TRASH="$DATA_DIR/trash"
  export CCS_OLD_TRASH="$CACHE_DIR/trash"      # pre-2026-11 location, migrated by the python side
fi
CCS_OWN_DIRS="$CONF_DIR"$'\n'"$CACHE_DIR"$'\n'"$DATA_DIR"; export CCS_OWN_DIRS   # the only directories ccs chmods to 0700
export CCS_PWD="${CCS_PWD:-$PWD}"

# The Python part is read with `read -d ''` rather than $(cat <<'PY'): bash 3.2 choked on
# an earlier version of this heredoc inside $(...), and `read` has no such parsing step.
read -r -d '' PYCODE <<'PY' || true
import os, sys, json, re, mmap, shutil, subprocess, time, zlib, datetime as dt

os.umask(0o077)          # everything ccs creates (index, state, trash, exports) is private to the user
CLAUDE_DIR = os.environ['CCS_CLAUDE_DIR']
PINS = os.environ['CCS_PINS']
STATE = os.environ['CCS_STATE']
CACHE = os.environ['CCS_CACHE']
TRASH = os.environ['CCS_TRASH']
CUR_PWD = os.path.realpath(os.environ.get('CCS_PWD') or os.getcwd())
PROJECTS = os.path.join(CLAUDE_DIR, 'projects')
SESSIONS = os.path.join(CLAUDE_DIR, 'sessions')
NAME_RE = re.compile(r'^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$')
SKIP = ('<command-name>', '<command-message>', '<local-command-stdout>', '<local-command-caveat>',
        '<system-reminder>', '<bash-input>', '<bash-stdout>', '<bash-stderr>', '<task-notification>',
        '[Request interrupted', 'Caveat: The messages below')
DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
SORTS = ['date', 'name', 'project']
FILTERS = ['all', 'pinned', 'live', 'here']
FILTER_LABEL = {'all': 'all', 'pinned': 'pinned only', 'live': 'open now', 'here': 'this directory'}
INDEX_VERSION = 5          # bump when scan_file() learns new fields: old cache entries get rescanned
PROMPT_CAP = 1000          # prompts kept per session for the full-text filter (bounded on purpose)
PROMPT_CHARS = 500         # characters kept per prompt
MODEL_RE = re.compile(rb'"model":"([^"<]{1,80})"')
PALETTE = ['34', '35', '36', '33', '32', '94', '95', '96', '93', '92']   # stable per-project colors


def c(code, s):
    return f"\033[{code}m{s}\033[0m"


# ---------- small persistent files ----------

def ensure_private():
    """ccs's own directories are 0700 and its own files 0600; directories chosen by the user
    through CCS_* overrides are left alone (they may be shared)."""
    own = [d for d in os.environ.get('CCS_OWN_DIRS', '').split('\n') if d]
    for d in own:
        try:
            os.makedirs(d, exist_ok=True)
            if os.stat(d).st_mode & 0o077:
                os.chmod(d, 0o700)
        except OSError as e:
            print(f"ccs: could not make {d} private: {e}", file=sys.stderr)
    for f in (PINS, STATE, CACHE):
        try:
            if os.path.isfile(f) and os.stat(f).st_mode & 0o077:
                os.chmod(f, 0o600)
        except OSError as e:
            print(f"ccs: could not make {f} private: {e}", file=sys.stderr)


def migrate_trash():
    """The trash used to live under the cache directory: move it where cache cleaners do not look,
    privately, merging into an existing new trash without ever overwriting."""
    old = os.environ.get('CCS_OLD_TRASH')
    if not old or not os.path.isdir(old) or os.path.realpath(old) == os.path.realpath(TRASH):
        return
    try:
        os.makedirs(TRASH, exist_ok=True)
        os.chmod(TRASH, 0o700)
        for proj in os.listdir(old):
            src_dir = os.path.join(old, proj)
            if not os.path.isdir(src_dir):
                continue
            dst_dir = os.path.join(TRASH, proj)
            os.makedirs(dst_dir, exist_ok=True)
            names = os.listdir(src_dir)
            units = {}                    # id -> [transcript?, sidecar dir?]: the two move together or not at all
            for name in names:
                m = NAME_RE.match(name)
                key = m.group(1) if m else (name if os.path.isdir(os.path.join(src_dir, name)) else None)
                if key is None:
                    continue              # set-aside backups (*.jsonl.<date>) stay where they are
                units.setdefault(key, []).append(name)
            for key, parts in units.items():
                if any(os.path.lexists(os.path.join(dst_dir, n)) for n in (f"{key}.jsonl", key)):
                    continue              # same id deleted twice: keep both, this one stays in the old place
                for n in parts:
                    shutil.move(os.path.join(src_dir, n), os.path.join(dst_dir, n))
            if not os.listdir(src_dir):
                os.rmdir(src_dir)
        if not os.listdir(old):
            os.rmdir(old)
        else:
            print(f"ccs: note: some older trash entries were left in {old} (same ids exist in {TRASH})", file=sys.stderr)
    except OSError as e:
        print(f"ccs: trash migration from {old} failed: {e}", file=sys.stderr)


def read_json(path, default):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return default


def write_json_atomic(path, data):
    # Unique temp name per process: list/header/preview may run concurrently.
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, separators=(',', ':'))
        os.replace(tmp, path)
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass


def load_pins():
    try:
        with open(PINS, encoding='utf-8') as f:
            return [l.strip() for l in f if l.strip()]
    except FileNotFoundError:
        return []


def save_pins(pins):
    os.makedirs(os.path.dirname(PINS), exist_ok=True)
    with open(PINS, 'w', encoding='utf-8') as f:
        f.write(''.join(p + '\n' for p in pins))


def load_state():
    st = read_json(STATE, {})
    if not isinstance(st, dict):
        st = {}
    st.setdefault('sort', 'date')
    st.setdefault('filter', 'all')
    st.setdefault('show_all', False)
    st.setdefault('text', '')
    st.setdefault('show_forks', False)
    if not isinstance(st['text'], str):
        st['text'] = ''
    if st['sort'] not in SORTS:
        st['sort'] = 'date'
    if st['filter'] not in FILTERS:
        st['filter'] = 'all'
    return st


def save_state(st):
    write_json_atomic(STATE, st)


# ---------- live sessions (registry written by claude itself) ----------

def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except Exception:
        return False


def live_sessions():
    """sessionId -> record from the ~/.claude/sessions/<pid>.json registry, live pids only.
    (A reused pid can make a closed session look open until Claude rewrites its registry file.)"""
    out = {}
    try:
        names = os.listdir(SESSIONS)
    except FileNotFoundError:
        return out
    for n in names:
        if not n.endswith('.json'):
            continue
        d = read_json(os.path.join(SESSIONS, n), None)
        if isinstance(d, dict) and d.get('sessionId') and isinstance(d.get('pid'), int) and pid_alive(d['pid']):
            out[d['sessionId']] = d
    return out


# ---------- transcript parsing ----------

def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return '\n'.join((b.get('text') or '') for b in content if isinstance(b, dict) and b.get('type') == 'text')
    return ''


CONTROL_RE = re.compile(r'\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[@-_]|[\x00-\x08\x0b-\x1f\x7f]')


def squash(s, n):
    s = ' '.join(CONTROL_RE.sub('', s).split())    # transcript text never drives the terminal
    return s if len(s) <= n else s[:n - 1].rstrip() + '…'


def is_prompt(d, txt):
    if d.get('isMeta') or d.get('isCompactSummary') or d.get('isVisibleInTranscriptOnly') or d.get('isSidechain'):
        return False
    t = txt.lstrip()
    return bool(t) and not t.startswith(SKIP)


def parse(line):
    try:
        return json.loads(line.decode('utf-8', 'replace'))
    except Exception:
        return None


def open_mm(path):
    try:
        f = open(path, 'rb')
    except OSError:
        return None, None
    try:
        if os.fstat(f.fileno()).st_size == 0:
            f.close()
            return None, None
        return f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
    except Exception:
        f.close()
        return None, None


def head_lines(mm, limit_bytes):
    pos, total, L = 0, 0, len(mm)
    while pos < L and total < limit_bytes:
        e = mm.find(b'\n', pos)
        if e < 0:
            e = L
        line = mm[pos:e]
        pos = e + 1
        total += len(line) + 1
        yield line


def last_entries(mm, needle, limit):
    """The last lines (scanning from the end) that contain needle, already parsed."""
    pos, n = len(mm), 0
    while n < limit:
        i = mm.rfind(needle, 0, pos)
        if i < 0:
            return
        s = mm.rfind(b'\n', 0, i) + 1
        e = mm.find(b'\n', i)
        d = parse(mm[s:(len(mm) if e < 0 else e)])
        if d is not None:
            yield d
            n += 1
        if s == 0:
            return
        pos = s


def scan_file(path, sid):
    info = dict(id=sid, path=path, cwd=None, branch=None, kind=None, version=None, model=None,
                first_prompt=None, first_ts=None, last_prompt=None, n_prompts=0, prompts=[],
                first_uuid=None, continued_in=[], title=None, title_src=None, unreadable=False)
    f, mm = open_mm(path)
    if mm is None:
        info['unreadable'] = os.path.getsize(path) > 0 if os.path.exists(path) else True
        return info
    try:
        # title: the last custom-title entry wins (that is what claude's picker reads), else the last ai-title
        for d in last_entries(mm, b'"type":"custom-title"', 6):
            t = d.get('customTitle') if d.get('type') == 'custom-title' else None
            if isinstance(t, str) and t.strip():
                info['title'], info['title_src'] = squash(t, 150), 'custom'
                break
        if not info['title']:
            for d in last_entries(mm, b'"type":"ai-title"', 6):
                t = d.get('aiTitle') if d.get('type') == 'ai-title' else None
                if isinstance(t, str) and t.strip():
                    info['title'], info['title_src'] = squash(t, 150), 'ai'
                    break
        # model: the last assistant message that names one (synthetic "<...>" models are skipped by the regex)
        pos = len(mm)
        for _ in range(8):
            i = mm.rfind(b'"model":"', 0, pos)
            if i < 0:
                break
            m = MODEL_RE.match(mm, i)
            if m:
                info['model'] = m.group(1).decode('ascii', 'replace')
                break
            pos = i
        # one full pass: metadata from the first entry, every real user prompt (for the text filter)
        pos, L, n_json, n_lines = 0, len(mm), 0, 0
        while pos < L:
            e = mm.find(b'\n', pos)
            if e < 0:
                e = L
            line = mm[pos:e]
            pos = e + 1
            if line.strip():
                n_lines += 1
                if line.startswith(b'{') and line.rstrip().endswith(b'}') and b'"type":"' in line:
                    n_json += 1
            if info['cwd'] is None and b'"cwd":' in line:
                d = parse(line)
                if d:
                    info['cwd'] = d.get('cwd') or None
                    info['branch'] = d.get('gitBranch') or None
                    info['kind'] = d.get('sessionKind') or None
                    info['version'] = d.get('version') or None
                    info['first_ts'] = d.get('timestamp') or None
            if b'"type":"continued-in"' in line:
                d = parse(line)
                if d and d.get('type') == 'continued-in' and d.get('continuedInSessionId'):
                    info['continued_in'].append(d['continuedInSessionId'])
                continue
            if b'"type":"user"' not in line or b'"tool_result"' in line or b'"isMeta":true' in line:
                continue
            d = parse(line)
            if not d or d.get('type') != 'user':
                continue
            if info['first_uuid'] is None and d.get('uuid'):
                info['first_uuid'] = d['uuid']     # forks copy the history, so this identifies the conversation
            txt = text_of((d.get('message') or {}).get('content'))
            if not is_prompt(d, txt):
                continue
            info['n_prompts'] += 1
            if info['first_prompt'] is None:
                info['first_prompt'] = squash(txt, 200)
                info['first_ts'] = info['first_ts'] or d.get('timestamp')
            info['last_prompt'] = squash(txt, 500)
            if len(info['prompts']) < PROMPT_CAP:
                info['prompts'].append(squash(txt, PROMPT_CHARS))
        if n_lines and n_json != n_lines:
            info['unreadable'] = True      # not (only) the compact JSONL Claude writes: never judge it empty
    finally:
        mm.close()
        f.close()
    return info


def build_index():
    cache = read_json(CACHE, {})
    if not isinstance(cache, dict):
        cache = {}
    out, changed = {}, False
    try:
        projects = [p for p in os.scandir(PROJECTS) if p.is_dir()]
    except FileNotFoundError:
        projects = []
    for proj in projects:
        for f in os.scandir(proj.path):
            m = NAME_RE.match(f.name)
            if not m or not f.is_file():
                continue
            try:
                st = f.stat()
                cached = cache.get(f.path)
                if (cached and cached.get('v') == INDEX_VERSION
                        and cached.get('mtime') == st.st_mtime and cached.get('size') == st.st_size):
                    out[f.path] = cached
                    continue
                info = scan_file(f.path, m.group(1))
            except OSError:
                changed = True            # removed meanwhile (another ccs, Claude's cleanup): skip it
                continue
            info.update(v=INDEX_VERSION, mtime=st.st_mtime, size=st.st_size, project_dir=proj.path)
            out[f.path] = info
            changed = True
    if changed or set(out) != set(cache):
        try:
            write_json_atomic(CACHE, out)
        except Exception:
            pass  # cache is only an accelerator; never fail the listing for it
    return list(out.values())


def find(sid, sessions=None):
    sessions = build_index() if sessions is None else sessions
    exact = [s for s in sessions if s['id'] == sid]
    if exact:
        return exact[0]
    pref = [s for s in sessions if s['id'].startswith(sid)]
    return pref[0] if len(pref) == 1 else None


# ---------- formatting ----------

def fmt_date(ts):
    d = dt.datetime.fromtimestamp(ts)
    now = dt.datetime.now()
    days = (now.date() - d.date()).days
    if days == 0:
        return f"today {d:%H:%M}"
    if days == 1:
        return f"yesterday {d:%H:%M}"
    if 0 < days < 7:
        return f"{DOW[d.weekday()]} {d:%H:%M}"
    if d.year == now.year:
        return f"{d:%d %b %H:%M}"
    return f"{d:%d %b %Y}"


def fmt_full(ts):
    return f"{dt.datetime.fromtimestamp(ts):%d %b %Y %H:%M}"


def fmt_iso(s):
    if not s:
        return '-'
    try:
        d = dt.datetime.fromisoformat(s.replace('Z', '+00:00')).astimezone()
        return f"{d:%d %b %Y %H:%M}"
    except Exception:
        return s


def human(n):
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return f"{n:.0f} {unit}" if unit == 'B' else f"{n:.1f} {unit}"
        n /= 1024.0


def fit(s, n):
    return squash(s, n).ljust(n)


def project_label(s):
    cwd = s.get('cwd')
    if cwd:
        return os.path.basename(cwd.rstrip('/')) or cwd
    name = os.path.basename(s.get('project_dir', '')).lstrip('-')
    return name if len(name) <= 18 else '…' + name[-17:]


def project_color(name):
    return PALETTE[zlib.crc32(name.casefold().encode('utf-8')) % len(PALETTE)]


def label(s):
    return (s.get('title') or s.get('first_prompt') or '').casefold()


def matches_text(s, words):
    hay = [(s.get('title') or ''), (s.get('first_prompt') or ''), (s.get('cwd') or '')] + list(s.get('prompts') or [])
    hay = [h.casefold() for h in hay]
    return all(any(w in h for h in hay) for w in words)


def text_hit(s, words):
    """The first prompt containing one of the words, for the grep output."""
    for pr in s.get('prompts') or []:
        low = pr.casefold()
        if any(w in low for w in words):
            return pr
    return ''


def is_here(s):
    cwd = s.get('cwd')
    return bool(cwd) and os.path.realpath(cwd) == CUR_PWD


# ---------- lineages: forks and daemon worker copies of one conversation ----------

def lineages(sessions, live=()):
    """id -> {'head': id shown in the list, 'members': [...], 'last': newest mtime, 'workers': {ids}}.
    Two transcripts belong to the same conversation when they start with the same user entry
    (a fork copies the history) or when one says it was 'continued-in' the other (daemon worker).
    The head is the worker that is running right now, if any (the original transcript only
    catches up when the worker retires), otherwise the newest non-worker transcript."""
    parent = {}

    def root(x):
        while parent.get(x, x) != x:
            parent[x] = parent.get(parent[x], parent[x])
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = root(a), root(b)
        if ra != rb:
            parent[ra] = rb

    by_id = {s['id']: s for s in sessions}
    by_first = {}
    for s in sessions:
        if s.get('first_uuid'):
            by_first.setdefault(s['first_uuid'], []).append(s['id'])
    for ids in by_first.values():
        for i in ids[1:]:
            union(ids[0], i)
    workers = set()
    for s in sessions:
        for t in s.get('continued_in') or []:
            if t in by_id:
                union(s['id'], t)
                workers.add(t)
    groups = {}
    for s in sessions:
        groups.setdefault(root(s['id']), []).append(s)
    out = {}
    for members in groups.values():
        running = [m for m in members if m['id'] in workers and m['id'] in live]
        live_any = [m for m in members if m['id'] in live]
        cands = running or live_any or [m for m in members if m['id'] not in workers] or members
        head = max(cands, key=lambda m: m['mtime'])['id']
        originals = [m for m in members if m['id'] not in workers]
        rec = {'head': head, 'members': sorted(members, key=lambda m: -m['mtime']),
               'last': max(m['mtime'] for m in members), 'workers': workers & {m['id'] for m in members},
               'original': max(originals, key=lambda m: m['mtime'])['id'] if originals else head}
        for m in members:
            out[m['id']] = rec
    return out


def eff_mtime(s, lin):
    rec = lin.get(s['id'])
    return rec['last'] if rec and rec['head'] == s['id'] else s['mtime']


# ---------- list / header / stats ----------

def visible_rows(sessions, st, pins, live, lin=None):
    lin = lineages(sessions, live) if lin is None else lin
    rows = [s for s in sessions if st['show_all'] or s.get('first_prompt') or s.get('title')]
    if not st.get('show_forks'):
        rows = [s for s in rows if lin[s['id']]['head'] == s['id'] or s['id'] in pins]
    flt = st['filter']
    if flt == 'pinned':
        rows = [s for s in rows if s['id'] in pins]
    elif flt == 'live':
        rows = [s for s in rows if s['id'] in live]
    elif flt == 'here':
        rows = [s for s in rows if is_here(s)]
    words = st.get('text', '').casefold().split()
    if words:
        rows = [s for s in rows if matches_text(s, words)]
    if st['sort'] == 'name':
        key = lambda s: (0 if s['id'] in pins else 1, label(s))
    elif st['sort'] == 'project':
