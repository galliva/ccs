             if s['id'] not in pins and not lineage_live(lin[s['id']], live) and s['mtime'] < cutoff
             and not s.get('unreadable') and (s.get('n_prompts') or 0) <= max_prompts]
    cands.sort(key=lambda s: s['mtime'])
    if not cands:
